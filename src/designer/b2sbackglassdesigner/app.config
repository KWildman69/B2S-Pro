<?xml version="1.0"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="B2SBackglassDesigner.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <runtime>
    <gcAllowVeryLargeObjects enabled="true" />
    <gcConcurrent enabled="true" />
  </runtime>
  <system.diagnostics>
    <sources>
      <source name="DefaultSource" switchName="DefaultSwitch">
        <listeners><add name="FileLog"/></listeners>
      </source>
    </sources>
    <switches><add name="DefaultSwitch" value="Information"/></switches>
    <sharedListeners>
      <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter"/>
    </sharedListeners>
  </system.diagnostics>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
  <userSettings>
    <B2SBackglassDesigner.My.MySettings>
      <setting name="DarkModeEnabled" serializeAs="String">
        <value>False</value>
      </setting>
    </B2SBackglassDesigner.My.MySettings>
  </userSettings>
</configuration>
